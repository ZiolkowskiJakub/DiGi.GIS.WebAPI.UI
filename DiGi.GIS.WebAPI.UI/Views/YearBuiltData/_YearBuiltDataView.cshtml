@using System.Linq
@using System.Collections.Generic
@using DiGi.GIS.WebAPI.UI.Classes
@using DiGi.GIS.Interfaces

@model YearBuiltDataView

@{
    @* Ensure we have a valid model instance *@
    YearBuiltDataView yearBuiltDataView = Model ?? new YearBuiltDataView();
}

@if (yearBuiltDataView.YearBuiltData is DiGi.GIS.Classes.YearBuiltData yearBuiltData &&
     yearBuiltData.YearBuilts is IEnumerable<IYearBuilt> yearBuilts &&
     yearBuilts.Any())
{
    @* Main container matching the 'Calculated General Properties' layout *@
    <div class="property-group success">
        @* Header with green accent color *@
        <h4>
            Year Builts
        </h4>

        <table class="gis-property-table">
            @{
                @* Logic to handle border-bottom visibility for the last row *@
                List<IYearBuilt> itemsList = yearBuilts.Where(x => x != null).ToList();
                int totalItems = itemsList.Count;
            }

            @for (int i = 0; i < totalItems; i++)
            {
                IYearBuilt yearBuilt = itemsList[i];
                string source = yearBuilt.Source ?? "???";
                string yearText = yearBuilt.Year.ToString();

                if(yearBuilt is DiGi.GIS.Classes.PredictedYearBuilt predictedYearBuilt)
                {
                    source = string.Format("{0} ({1})", predictedYearBuilt.YearBuiltSource.ToString(), predictedYearBuilt.DateTime.ToString());
                }

                <tr>
                    @* First column: Source *@
                    <td class="property-label">
                        @source:
                    </td>
                    @* Second column: Year *@
                    <td>
                        @yearText
                    </td>
                </tr>
            }
        </table>
    </div>
}