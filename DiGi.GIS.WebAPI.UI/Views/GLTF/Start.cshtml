@{
    ViewData["Title"] = "3D Viewer";
    ViewData["Description"] = "Render buildings and spatial objects in 3D using the glTF standard.";
}

<div class="gis-panel">
    <div class="gis-card" style="text-align: center; padding: 50px 20px;">
        @* Single-building line icon (consistent line-icon set shared with the communication start page). *@
        <div style="margin-bottom: 20px; color: var(--primary-color); line-height: 0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true" style="display: inline-block;">
                <rect width="16" height="20" x="4" y="2" rx="2" ry="2" />
                <path d="M9 22v-4h6v4" />
                <path d="M8 6h.01" />
                <path d="M16 6h.01" />
                <path d="M12 6h.01" />
                <path d="M12 10h.01" />
                <path d="M12 14h.01" />
                <path d="M16 10h.01" />
                <path d="M16 14h.01" />
                <path d="M8 10h.01" />
                <path d="M8 14h.01" />
            </svg>
        </div>
        <h2 class="gis-title" style="border: none; padding: 0; margin-bottom: 15px; display: block; font-size: 1.8rem;">Building Viewer</h2>
        <p style="color: var(--text-muted); max-width: 520px; margin: 0 auto 30px; font-size: 1.1rem; line-height: 1.6;">
            Load a single building by its identifier and explore it in 3D. The footprint is extruded to the building height from its number of storeys, so you can inspect its shape, size and surroundings from any angle.
        </p>
        <form method="get" action="~/gltf/building2dbyid" style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; align-items: center;">
            <label style="color: var(--text-muted);">Building Id
                <input type="number" name="id" value="5072294" required style="margin-left: 6px; padding: 6px; width: 100px;" />
            </label>
            <label style="color: var(--text-muted);">County Id
                <input type="number" name="countyid" value="12668" style="margin-left: 6px; padding: 6px; width: 80px;" />
            </label>
            <label style="color: var(--text-muted);">Storey height [m]
                <input type="number" name="storeyheight" value="3" step="0.1" min="1" style="margin-left: 6px; padding: 6px; width: 70px;" />
            </label>
            <button type="submit" class="gis-button">Open</button>
        </form>
    </div>

    <div class="gis-card" style="text-align: center; padding: 50px 20px; margin-top: 16px;">
        @* Multiple-buildings line icon (consistent line-icon set shared with the communication start page). *@
        <div style="margin-bottom: 20px; color: var(--primary-color); line-height: 0;">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true" style="display: inline-block;">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z" />
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2" />
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2" />
                <path d="M10 6h4" />
                <path d="M10 10h4" />
                <path d="M10 14h4" />
                <path d="M10 18h4" />
            </svg>
        </div>
        <h2 class="gis-title" style="border: none; padding: 0; margin-bottom: 15px; display: block; font-size: 1.8rem;">Multiple Buildings Viewer</h2>
        <p style="color: var(--text-muted); max-width: 520px; margin: 0 auto 30px; font-size: 1.1rem; line-height: 1.6;">
            Enter a central point and a radius to load all buildings within that circular area and explore the whole district in 3D.
        </p>
        <form method="get" action="~/gltf/buildingsbyradius" style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; align-items: center;">
            <label style="color: var(--text-muted);">Point X
                <input type="number" name="centerX" value="629671.3" step="any" required style="margin-left: 6px; padding: 6px; width: 100px;" />
            </label>
            <label style="color: var(--text-muted);">Point Y
                <input type="number" name="centerY" value="489136.8" step="any" required style="margin-left: 6px; padding: 6px; width: 100px;" />
            </label>
            <label style="color: var(--text-muted);">Radius [m]
                <input type="number" name="radius" value="500" step="any" min="1" required style="margin-left: 6px; padding: 6px; width: 70px;" />
            </label>
            <label style="color: var(--text-muted);">Storey height [m]
                <input type="number" name="storeyheight" value="3" step="0.1" min="1" style="margin-left: 6px; padding: 6px; width: 70px;" />
            </label>
            <button type="submit" class="gis-button">Open</button>
        </form>
    </div>
</div>
