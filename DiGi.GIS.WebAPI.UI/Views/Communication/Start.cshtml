@{
    ViewData["Title"] = "Communication";
    ViewData["Description"] = "Analyze radio communication between antennas placed in a 3D district model.";
}

<div class="gis-panel">
    <div class="gis-card gis-hero-card">
        @* Radio-tower line icon (consistent line-icon set shared with the glTF start page). *@
        <div class="gis-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                <path d="M4.9 16.1C1 12.2 1 5.8 4.9 2" />
                <path d="M7.8 4.7a6.14 6.14 0 0 0-.8 7.5" />
                <circle cx="12" cy="9" r="2" />
                <path d="M16.2 4.8c2 2 2 5.2 0 7.2" />
                <path d="M19.1 2c3.9 3.9 3.9 10.3 0 14.2" />
                <path d="M9.9 21.2 12 12l2.1 9.2" />
            </svg>
        </div>
        <h2 class="gis-title gis-title-hero">Communication</h2>
        <p class="gis-hero-text">
            Enter a central point and a radius to load all buildings within that circular area, place antennas in the 3D view and analyze the radio communication between them.
        </p>
        <form method="get" action="~/communication/buildingsbyradius" class="gis-inline-form">
            <label>Point X
                <input type="number" name="centerX" value="629671.3" step="any" required />
            </label>
            <label>Point Y
                <input type="number" name="centerY" value="489136.8" step="any" required />
            </label>
            <label>Radius [m]
                <input type="number" name="radius" value="500" step="any" min="1" required class="gis-input-sm" />
            </label>
            <button type="submit" class="gis-button">Open</button>
        </form>
    </div>
</div>
