@model DiGi.GIS.WebAPI.UI.ViewModels.CommunicationSceneViewModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = Model.Title ?? "Communication 3D Viewer";
    ViewData["Description"] = "Interactive communication analysis: place antennas in the 3D district model and calculate the radio propagation between them.";
}

<div class="gis-panel gis-panel-full">

    <div class="gltf-layout">
        @* Left side panel (open by default) *@
        <aside id="gltf-left-panel" class="gltf-left-panel">
            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Controls</h3>
                <div class="gltf-controls-list">
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Middle drag</span>
                        <span class="gltf-control-val">Pan</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Shift + Middle drag</span>
                        <span class="gltf-control-val">Orbit</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Scroll wheel</span>
                        <span class="gltf-control-val">Zoom</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Left drag (L → R)</span>
                        <span class="gltf-control-val">Window select</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Left drag (R → L)</span>
                        <span class="gltf-control-val">Crossing select</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Right click</span>
                        <span class="gltf-control-val">Context menu</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Drag box edge</span>
                        <span class="gltf-control-val">Move scope box</span>
                    </div>
                    <div class="gltf-control-row">
                        <span class="gltf-control-key">Click box edge</span>
                        <span class="gltf-control-val">Resize/rotate handles</span>
                    </div>
                </div>
            </div>

            <div class="gis-card gltf-card" id="communication-card" data-expanded="true">
                <h3 class="gltf-card-title">Communication</h3>
                <button type="button" id="communication-add-antenna-button" class="gis-button" disabled title="Place a new antenna on the ground plane (Z = 0)">Add antenna</button>
                <button type="button" id="communication-remove-antenna-button" class="gis-button" disabled title="Select antennas to remove (Enter removes, Esc cancels)">Remove antenna</button>
                <button type="button" id="communication-calculate-button" class="gis-button" disabled title="Calculate the communication between the two antennas">Calculate</button>
                <button type="button" id="communication-clear-button" class="gis-button" title="Remove all antennas and calculation results">Clear</button>
            </div>

            @* Environment settings card: the generic viewer engine mounts its controls (gizmo/ground
               visibility, fog, view range) into the #gltf-settings element. *@
            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Settings</h3>
                <div id="gltf-settings"></div>
            </div>
        </aside>

        @* Left resizer *@
        <div id="gltf-left-resizer" class="gltf-resizer" role="separator" aria-label="Resize left panels"></div>

        @* Streamed delivery: the viewer fetches the binary glTF payload from data-glb-url. The data-*
           attributes carry the scene input parameters so the calculation request can rebuild the
           analyzed area on the server without any client side storage.
           data-status-terminal: boolean flag of the task status terminal docked to the bottom edge
           of the 3D view — "false" removes the text area and its splitter entirely.
           data-scope-box-size: default scope box preset "halfX;halfY;zMin;zMax" (DiGi coordinates). *@
        <div id="gltf-viewer-container"
             data-status-terminal="true"
             data-scope-box-size="50;50;-1;49"
             data-glb-url="@(string.IsNullOrEmpty(Model.GLBUrl) ? string.Empty : Url.Content(Model.GLBUrl))"
             data-building-details-url="@Url.Content("~/building2D/detailsbyreference")"
             data-buildingmodel-details-url="@Url.Content("~/buildingmodel/itembyreference")"
             data-sun-direction-url="@Url.Content("~/solar/sundirection")"
             data-calculate-url="@Url.Content("~/communication/calculate")"
             data-center-x="@Model.CenterX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-center-y="@Model.CenterY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-radius="@Model.Radius.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-storey-height="@Model.StoreyHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <div id="gltf-loader" class="gltf-loader">
                <div class="gis-loader"></div>
                <p class="gis-loader-text">Loading 3D scene…</p>
            </div>
            <div id="communication-calculation-loader" class="gltf-loader" style="display: none;">
                <div class="gis-loader"></div>
                <p class="gis-loader-text">Calculating propagation…</p>
            </div>
            @* Small toggle in the top-left corner that folds/unfolds the left side panel. *@
            <button type="button" id="gltf-left-panel-toggle" class="gltf-left-panel-toggle" title="Hide controls" aria-label="Hide controls" aria-controls="gltf-left-panel" aria-expanded="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
            @* Small toggle in the top-right corner that folds/unfolds the right side panel. *@
            <button type="button" id="gltf-panel-toggle" class="gltf-panel-toggle" title="Hide panel" aria-label="Hide panel" aria-controls="gltf-side-panel" aria-expanded="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
            @* Hover label, selection marquee, navigation hint and right-click context menu (Fit view,
               Fit selection, Clear selection) overlays are created by the generic viewer engine. *@
        </div>

        <div id="gltf-resizer" class="gltf-resizer" role="separator" aria-label="Resize panels"></div>

        @* The cards are kept in alphabetical order by title (Lighting, Properties, Results, Scene,
           Selection) — hidden cards (Results, Selection) appear in place when user interaction
           reveals them. *@
        <aside id="gltf-side-panel" class="gltf-side-panel">
            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Lighting</h3>
                @* Date + time drive the sun position: on change the scene's world location and the
                   selected moment go to the sun-direction endpoint (DiGi.Solar / DiGi.GIS server
                   side) and the returned azimuth/altitude animate the two sliders below. *@
                <label class="gltf-slider-label">Date
                    <input type="date" id="gltf-sun-date" class="gltf-date-input" />
                </label>
                <label class="gltf-slider-label">Time <span id="gltf-sun-hour-value"></span>
                    <input type="range" id="gltf-sun-hour" min="0" max="24" step="0.25" />
                </label>
                <label class="gltf-slider-label">Sun azimuth <span id="gltf-sun-azimuth-value"></span>
                    <input type="range" id="gltf-sun-azimuth" min="0" max="360" step="1" />
                </label>
                <label class="gltf-slider-label">Sun altitude <span id="gltf-sun-altitude-value"></span>
                    <input type="range" id="gltf-sun-altitude" min="2" max="90" step="1" />
                </label>
                <label class="gltf-slider-label">Sun intensity <span id="gltf-sun-intensity-value"></span>
                    <input type="range" id="gltf-sun-intensity" min="0" max="5" step="0.1" />
                </label>
                <label class="gltf-slider-label">Ambient intensity <span id="gltf-ambient-intensity-value"></span>
                    <input type="range" id="gltf-ambient-intensity" min="0" max="2" step="0.05" />
                </label>
            </div>

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Properties</h3>
                <div id="gltf-properties" class="gltf-properties">
                    <span class="gltf-muted">Click an object or drag a selection rectangle in the 3D view. Properties are displayed when exactly one object is selected.</span>
                </div>
            </div>

            @* Results panel: hidden until a calculation succeeds. It shows the general propagation
               results (total/directional power, per delay components) after a calculation and the
               ray specific values when a green ray is selected in the 3D view; the content is filled
               by communication-tools.js. For the delay based (v1) flow the panel additionally hosts
               the delay slider (the 3D view renders the propagation ellipsoid, the scattering
               polylines and the angular power distribution vectors of the selected delay) and the
               vector scale factor stretching the rendered vectors (see renderDelayResults). *@
            <div class="gis-card gltf-card" id="communication-results-card" style="display: none;">
                <h3 class="gltf-card-title">Results</h3>
                <div id="communication-delay-controls" style="display: none;">
                    <label class="gltf-slider-label">Delay <span id="communication-delay-value"></span>
                        <input type="range" id="communication-delay-slider" min="0" max="0" step="1" value="0" />
                    </label>
                    <label class="communication-modal-label">Vector scale
                        <input type="number" id="communication-vector-scale" step="any" min="0" value="10" />
                    </label>
                </div>
                <div id="communication-results" class="gltf-properties"></div>
                @* "Details" opens the scattering hit matrix of the delay currently selected above. It
                   stays hidden while the selected delay has no scattering hits. The button is authored
                   here rather than appended by script because initCardFolding (gltf-viewer.js) moves
                   everything following the card title into a generated .gltf-card-content wrapper on load. *@
                <button type="button" id="communication-results-details-button" class="gis-button" style="display: none;">Details</button>
                @* Static hint, below the Details button. The card is only ever shown by the delay based
                   flow (showDelayResults), so it needs no separate visibility handling. *@
                <div class="gltf-muted communication-results-note">Move the delay slider above to change the displayed delay. Click a scattering polyline for its auxiliary polylines and data (Selection panel).</div>
            </div>

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Scene</h3>
                <div id="gltf-scene-info" class="gltf-properties"></div>
            </div>

            @* Selection card: shown by building-details-panel.js when exactly one building is selected
               ("Details" opens the standalone building details page, "Export" shows the selected
               object's data as formatted JSON in a modal), when an antenna is selected in the 3D
               view ("Edit" reopens the antenna modal with the antenna values, "Export" works like for
               buildings) and when a scattering polyline is selected (the polyline data fills the
               #communication-selection block, no buttons; see communication-tools.js). *@
            <div class="gis-card gltf-card" id="building-details-card" style="display: none;">
                <h3 class="gltf-card-title">Selection</h3>
                <div id="communication-selection" class="gltf-properties" style="display: none;"></div>
                <a id="building-details-show-link" class="gis-button" href="#" target="_blank" rel="noopener">Details</a>
                <button type="button" id="communication-antenna-edit-button" class="gis-button" style="display: none;">Edit</button>
                <button type="button" id="building-export-button" class="gis-button">Export</button>
            </div>
        </aside>
    </div>
</div>

@* Calculation modal: opened by the "Calculate" button. Only the multipath power delay profile is
   user configurable; the remaining propagation inputs are solved in process. *@
<div id="communication-calculation-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal">
        <h3 class="gltf-card-title">Calculate propagation</h3>
        <label class="communication-modal-label">Power delay profile
            <select id="communication-calculation-profile">
                @foreach (DiGi.Communication.Enums.DefaultSimpleMultipathPowerDelayProfile profile in System.Enum.GetValues<DiGi.Communication.Enums.DefaultSimpleMultipathPowerDelayProfile>())
                {
                    System.Reflection.FieldInfo? fieldInfo = typeof(DiGi.Communication.Enums.DefaultSimpleMultipathPowerDelayProfile).GetField(profile.ToString());
                    System.ComponentModel.DescriptionAttribute? descriptionAttribute = fieldInfo is not null ? System.Attribute.GetCustomAttribute(fieldInfo, typeof(System.ComponentModel.DescriptionAttribute)) as System.ComponentModel.DescriptionAttribute : null;
                    string displayName = descriptionAttribute?.Description ?? profile.ToString();
                    <option value="@profile">@displayName</option>
                }
            </select>
        </label>
        <div class="gis-modal-buttons">
            <button type="button" id="communication-calculation-ok-button" class="gis-button">OK</button>
            <button type="button" id="communication-calculation-cancel-button" class="gis-button">Cancel</button>
        </div>
    </div>
</div>

@* Antenna modal: opened after the user clicks a point on the ground plane in "Add antenna" mode and
   by the "Edit" button of the Selection card (the title switches to "Edit antenna" and the fields are
   pre-filled with the selected antenna values). *@
<div id="communication-antenna-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal">
        <h3 class="gltf-card-title" id="communication-antenna-modal-title">Add antenna</h3>
        <label class="communication-modal-label">X coordinate
            <input type="number" id="communication-antenna-x" step="any" required />
        </label>
        <label class="communication-modal-label">Y coordinate
            <input type="number" id="communication-antenna-y" step="any" required />
        </label>
        <label class="communication-modal-label">Z (Height) [m]
            <input type="number" id="communication-antenna-z" step="any" min="0" value="30" required />
        </label>
        <fieldset class="communication-modal-functions">
            <legend>Functions</legend>
            @* The checkbox list maps to the DiGi.Communication Function enum; all values are selected by default. *@
            @foreach (DiGi.Communication.Enums.Function function in System.Enum.GetValues<DiGi.Communication.Enums.Function>())
            {
                <label class="communication-modal-checkbox">
                    <input type="checkbox" class="communication-antenna-function" value="@function" checked /> @function
                </label>
            }
        </fieldset>
        <div class="gis-modal-buttons">
            <button type="button" id="communication-antenna-ok-button" class="gis-button">OK</button>
            <button type="button" id="communication-antenna-cancel-button" class="gis-button">Cancel</button>
        </div>
    </div>
</div>

@* Scene change modal: opened by the "Change" button in the Scene panel; collects the
   analyzed circular area parameters (center X/Y, radius, storey height) so the user
   can reload the 3D view for a different area without going back to the start page. *@
<div id="scene-change-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal">
        <h3 class="gltf-card-title">Change scene</h3>
        <label class="communication-modal-label">Point X
            <input type="number" id="scene-change-x" step="any" required />
        </label>
        <label class="communication-modal-label">Point Y
            <input type="number" id="scene-change-y" step="any" required />
        </label>
        <label class="communication-modal-label">Radius [m]
            <input type="number" id="scene-change-radius" step="any" min="1" required />
        </label>
        <label class="communication-modal-label">Storey height [m]
            <input type="number" id="scene-change-storey-height" step="0.1" min="1" />
        </label>
        <div class="gis-modal-buttons">
            <button type="button" id="scene-change-ok-button" class="gis-button">OK</button>
            <button type="button" id="scene-change-cancel-button" class="gis-button">Cancel</button>
        </div>
    </div>
</div>

@* Scattering matrix modal: step 1 of 3, opened by the "Details" button of the Results panel. It shows
   the scattering hits of the selected delay as a matrix of the populated azimuth ranges (columns)
   against the populated elevation ranges (rows); every populated intersection renders a button with
   the number of electrical property groups of that bin, which opens the groups modal below. *@
<div id="communication-scattering-matrix-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal gis-modal-wide">
        <h3 class="gltf-card-title" id="communication-scattering-matrix-title">Scattering hits</h3>
        <div id="communication-scattering-matrix"></div>
        <div class="gis-modal-buttons">
            <button type="button" id="communication-scattering-matrix-close-button" class="gis-button">Close</button>
        </div>
    </div>
</div>

@* Scattering groups modal: step 2 of 3, opened by a cell of the scattering matrix; lists the
   electrical properties the hits of that azimuth/elevation bin are grouped by, each row carrying a
   button with the hit count of its group which opens the scattering hits modal below. The three
   overlays share the same z-index, so each is declared after the one it paints above. *@
<div id="communication-scattering-groups-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal gis-modal-wide">
        <h3 class="gltf-card-title" id="communication-scattering-groups-title">Electrical properties</h3>
        <div id="communication-scattering-groups"></div>
        <div class="gis-modal-buttons">
            <button type="button" id="communication-scattering-groups-close-button" class="gis-button">Close</button>
        </div>
    </div>
</div>

@* Scattering hits modal: step 3 of 3, opened by a row of the groups modal; lists the individual hits
   of one electrical property group of one azimuth/elevation bin. Declared after the groups modal so it
   paints above it - all three overlays share the same z-index. *@
<div id="communication-scattering-hits-modal" class="gis-modal-overlay" style="display: none;">
    <div class="gis-card gis-modal gis-modal-wide">
        <h3 class="gltf-card-title" id="communication-scattering-hits-title">Scattering hits</h3>
        <div id="communication-scattering-hits"></div>
        <div class="gis-modal-buttons">
            <button type="button" id="communication-scattering-hits-close-button" class="gis-button">Close</button>
        </div>
    </div>
</div>

@section Scripts {
    @* The '!' prefix opts this element out of tag helper processing: the script tag helper
       would otherwise strip the type="importmap" attribute and break module resolution. *@
    <!script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
                "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/",
                "three-mesh-bvh": "https://cdn.jsdelivr.net/npm/three-mesh-bvh@0.8/build/index.module.js",
                "gltf-viewer-core": "@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/js/gltf-viewer-core.js")"
            }
        }
    </!script>
    <script type="module" src="~/js/gltf-viewer.js" asp-append-version="true"></script>
    <script type="module" src="~/js/communication-tools.js" asp-append-version="true"></script>
    <script type="module" src="~/js/building-details-panel.js" asp-append-version="true"></script>
}
