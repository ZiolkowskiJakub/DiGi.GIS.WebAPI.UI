@model DiGi.GIS.WebAPI.UI.ViewModels.CommunicationSceneViewModel
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    ViewData["Title"] = Model.Title ?? "Communication 3D Viewer";
    ViewData["Description"] = "Interactive communication analysis: place antennas in the 3D district model and calculate the radio propagation between them.";
}

<div class="gis-panel">
    <h2 id="gltf-title" class="gis-title">@(Model.Title ?? "Communication 3D Viewer")</h2>

    @* Communication toolbar: sits between the page header and the 3D canvas viewport. *@
    <div id="communication-toolbar" class="communication-toolbar">
        <button type="button" id="communication-add-antenna-button" class="gis-button" disabled title="Place a new antenna on the ground plane (Z = 0)">Add antenna</button>
        <button type="button" id="communication-remove-antenna-button" class="gis-button" disabled title="Select antennas to remove (Enter removes, Esc cancels)">Remove antenna</button>
        <button type="button" id="communication-calculate-button" class="gis-button" disabled title="Calculate the communication between the two antennas">Calculate</button>
        <button type="button" id="communication-clear-button" class="gis-button" title="Remove all antennas and calculation results">Clear</button>
        <span id="communication-mode-hint" class="communication-mode-hint"></span>
    </div>

    <div class="gltf-layout">
        @* Streamed delivery: the viewer fetches the binary glTF payload from data-glb-url. The data-*
           attributes carry the scene input parameters so the calculation request can rebuild the
           analyzed area on the server without any client side storage. *@
        <div id="gltf-viewer-container"
             data-glb-url="@(string.IsNullOrEmpty(Model.GLBUrl) ? string.Empty : Url.Content(Model.GLBUrl))"
             data-building-details-url="@Url.Content("~/building2D/detailsbyreference")"
             data-calculate-url="@Url.Content("~/communication/calculate")"
             data-center-x="@Model.CenterX.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-center-y="@Model.CenterY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-radius="@Model.Radius.ToString(System.Globalization.CultureInfo.InvariantCulture)"
             data-storey-height="@Model.StoreyHeight.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <div id="gltf-toolbar">
                <button type="button" id="gltf-fit-button" class="gis-button" title="Frame the whole scene">Fit view</button>
                <button type="button" id="gltf-clear-button" class="gis-button" title="Clear the current selection">Clear selection</button>
            </div>
            @* Small toggle in the top-right corner that folds/unfolds the right side panel. *@
            <button type="button" id="gltf-panel-toggle" class="gltf-panel-toggle" title="Hide panel" aria-label="Hide panel" aria-controls="gltf-side-panel" aria-expanded="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                </svg>
            </button>
            @* Hover label, selection marquee and navigation hint overlays are created by the generic viewer engine. *@
        </div>

        <aside id="gltf-side-panel" class="gltf-side-panel">
            @* Results panel: hidden until a calculation succeeds. It shows the general propagation
               results (total/directional power, per delay components) after a calculation and the
               ray specific values when a green ray is selected in the 3D view; the content is filled
               by communication-tools.js. *@
            <div class="gis-card gltf-card" id="communication-results-card" style="display: none;">
                <h3 class="gltf-card-title">Results</h3>
                <div id="communication-results" class="gltf-properties"></div>
            </div>

            @* Details card: shown by building-details-panel.js when exactly one building is selected;
               the "Show" button opens the standalone building details page. *@
            <div class="gis-card gltf-card" id="building-details-card" style="display: none;">
                <h3 class="gltf-card-title">Details</h3>
                <div style="text-align: center;">
                    <a id="building-details-show-link" class="gis-button" href="#" target="_blank" rel="noopener" style="display: inline-block;">Show</a>
                </div>
            </div>

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Lighting</h3>
                <label class="gltf-slider-label">Sun azimuth <span id="gltf-sun-azimuth-value"></span>
                    <input type="range" id="gltf-sun-azimuth" min="0" max="360" step="1" />
                </label>
                <label class="gltf-slider-label">Sun altitude <span id="gltf-sun-altitude-value"></span>
                    <input type="range" id="gltf-sun-altitude" min="2" max="90" step="1" />
                </label>
                <label class="gltf-slider-label">Sun intensity <span id="gltf-sun-intensity-value"></span>
                    <input type="range" id="gltf-sun-intensity" min="0" max="5" step="0.1" />
                </label>
                <label class="gltf-slider-label">Ambient intensity <span id="gltf-ambient-intensity-value"></span>
                    <input type="range" id="gltf-ambient-intensity" min="0" max="2" step="0.05" />
                </label>
            </div>

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Properties</h3>
                <div id="gltf-properties" class="gltf-properties">
                    <span class="gltf-muted">Click an object or drag a selection rectangle in the 3D view. Properties are displayed when exactly one object is selected.</span>
                </div>
            </div>

            <div class="gis-card gltf-card">
                <h3 class="gltf-card-title">Scene</h3>
                <div id="gltf-scene-info" class="gltf-properties"></div>
            </div>
        </aside>
    </div>
</div>

@* Calculation modal: opened by the "Calculate" button; collects the propagation inputs that are
   not part of the geometrical model (frequency, polarization and the electrical material
   properties of the scattering objects).
   AI-NOTE (mocked remaining inputs): the multipath power delay profile (TypicalUrban preset) and
   the antenna radiation characteristics are currently hardcoded server side — the profile in
   CommunicationController.CalculateAsync, the characteristics in the DiGi.Communication.WebAPI
   propagationresults endpoint — both mirroring the reference xUnit fact
   ToPropagation_PropagationModel_TypicalUrban. Replace them with additional modal inputs here once
   they become user configurable.
   AI-NOTE (multi-frequency extensibility): the frequency field accepts a comma separated list
   (e.g. "900, 1800"); communication-tools.js parses it into the Frequencies array of the request
   payload and the backend calculates every entry. The 3D view currently renders the first
   frequency only — add a per frequency toggle to the results panel to expose the remaining
   entries (see renderResults in communication-tools.js). *@
<div id="communication-calculation-modal" class="communication-modal-overlay" style="display: none;">
    <div class="gis-card communication-modal">
        <h3 class="gltf-card-title">Calculate propagation</h3>
        <label class="communication-modal-label">Frequency [MHz] (comma separated for multiple)
            <input type="text" id="communication-calculation-frequency" value="900" required />
        </label>
        <label class="communication-modal-label">Polarization
            <select id="communication-calculation-polarization">
                @* The option list maps to the DiGi.Communication.Propagation Polarization enum. *@
                @foreach (DiGi.Communication.Propagation.Enums.Polarization polarization in System.Enum.GetValues<DiGi.Communication.Propagation.Enums.Polarization>())
                {
                    <option value="@polarization">@polarization</option>
                }
            </select>
        </label>
        <fieldset class="communication-modal-functions">
            <legend>Material properties</legend>
            <label class="communication-modal-label">Relative electrical permittivity [-]
                <input type="number" id="communication-calculation-permittivity" step="any" min="1" value="15" required />
            </label>
            <label class="communication-modal-label">Electrical conductivity [S/m]
                <input type="number" id="communication-calculation-conductivity" step="any" min="0" value="0.005" required />
            </label>
        </fieldset>
        <div class="communication-modal-buttons">
            <button type="button" id="communication-calculation-ok-button" class="gis-button">OK</button>
            <button type="button" id="communication-calculation-cancel-button" class="gis-button">Cancel</button>
        </div>
    </div>
</div>

@* Antenna modal: opened after the user clicks a point on the ground plane in "Add antenna" mode. *@
<div id="communication-antenna-modal" class="communication-modal-overlay" style="display: none;">
    <div class="gis-card communication-modal">
        <h3 class="gltf-card-title">Add antenna</h3>
        <label class="communication-modal-label">X coordinate
            <input type="number" id="communication-antenna-x" step="any" required />
        </label>
        <label class="communication-modal-label">Y coordinate
            <input type="number" id="communication-antenna-y" step="any" required />
        </label>
        <label class="communication-modal-label">Z (Height) [m]
            <input type="number" id="communication-antenna-z" step="any" min="0" value="0" required />
        </label>
        <fieldset class="communication-modal-functions">
            <legend>Functions</legend>
            @* The checkbox list maps to the DiGi.Communication Function enum; all values are selected by default. *@
            @foreach (DiGi.Communication.Enums.Function function in System.Enum.GetValues<DiGi.Communication.Enums.Function>())
            {
                <label class="communication-modal-checkbox">
                    <input type="checkbox" class="communication-antenna-function" value="@function" checked /> @function
                </label>
            }
        </fieldset>
        <div class="communication-modal-buttons">
            <button type="button" id="communication-antenna-ok-button" class="gis-button">OK</button>
            <button type="button" id="communication-antenna-cancel-button" class="gis-button">Cancel</button>
        </div>
    </div>
</div>

<style>
    /* The theme panel shrinks to fit (auto cross-axis margins prevent flex stretching) — force full width on this page so the 3D view can stretch with the window. */
    .gis-panel {
        width: 95%;
        max-width: none;
        margin-top: 20px;
        margin-bottom: 20px;
    }

    .communication-toolbar {
        display: flex;
        gap: 8px;
        align-items: center;
        flex-wrap: wrap;
        margin: 0 0 12px 0;
    }

    /* The hint must never wrap: growing the toolbar would shift the 3D canvas mid-interaction. */
    .communication-mode-hint {
        color: var(--text-muted);
        font-size: 0.85rem;
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* The 3D view always stretches with the window; the side panel stays docked on the right. */
    .gltf-layout {
        display: flex;
        gap: 16px;
        align-items: stretch;
        height: calc(100vh - 300px);
        min-height: 480px;
    }

    #gltf-viewer-container {
        position: relative;
        flex: 1 1 auto;
        min-width: 0;
        height: 100%;
        border-radius: 8px;
        overflow: hidden;
        background: #171a21;
    }

    #gltf-toolbar {
        position: absolute;
        top: 10px;
        left: 10px;
        z-index: 5;
        display: flex;
        gap: 8px;
    }

    /* Small toggle in the top-right corner that folds/unfolds the right side panel. */
    .gltf-panel-toggle {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 5;
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: rgba(255, 255, 255, 0.92);
        color: #333333;
        border: 1px solid rgba(0, 0, 0, 0.12);
        border-radius: 8px;
        cursor: pointer;
        transition: background 0.2s ease, color 0.2s ease;
    }

    .gltf-panel-toggle:hover {
        color: var(--primary-color);
        background: #ffffff;
    }

    .gltf-panel-toggle svg {
        transition: transform 0.2s ease;
    }

    /* Folded state: hide the side panel (the viewer expands to fill) and flip the chevron. */
    .gltf-layout.gltf-panel-collapsed .gltf-side-panel {
        display: none;
    }

    .gltf-layout.gltf-panel-collapsed .gltf-panel-toggle svg {
        transform: rotate(180deg);
    }

    .gltf-side-panel {
        flex: 0 0 340px;
        display: flex;
        flex-direction: column;
        gap: 12px;
        height: 100%;
        overflow-y: auto;
    }

    .gltf-card-title {
        margin: 0 0 10px 0;
        font-size: 1rem;
    }

    .gltf-slider-label {
        display: block;
        font-size: 0.85rem;
        color: var(--text-muted);
        margin-bottom: 8px;
    }

    .gltf-slider-label input[type="range"] {
        width: 100%;
        display: block;
    }

    .gltf-properties {
        font-size: 0.85rem;
        word-break: break-word;
        max-height: 320px;
        overflow-y: auto;
    }

    .gltf-properties table {
        width: 100%;
        border-collapse: collapse;
    }

    .gltf-properties td {
        padding: 3px 6px;
        vertical-align: top;
        border-bottom: 1px solid rgba(128, 128, 128, 0.15);
    }

    .gltf-properties td:first-child {
        font-weight: 600;
        white-space: nowrap;
    }

    .gltf-muted {
        color: var(--text-muted);
    }

    .communication-modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(0, 0, 0, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .communication-modal {
        width: 320px;
        max-width: 90vw;
    }

    .communication-modal-label {
        display: block;
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-bottom: 10px;
    }

    .communication-modal-label input,
    .communication-modal-label select {
        display: block;
        width: 100%;
        box-sizing: border-box;
        padding: 6px 8px;
        margin-top: 4px;
    }

    .communication-modal-functions {
        border: 1px solid rgba(128, 128, 128, 0.35);
        border-radius: 4px;
        margin: 0 0 12px 0;
        padding: 8px 10px;
    }

    .communication-modal-functions legend {
        font-size: 0.85rem;
        color: var(--text-muted);
        padding: 0 4px;
    }

    .communication-modal-checkbox {
        display: block;
        font-size: 0.9rem;
        margin-bottom: 4px;
    }

    .communication-modal-buttons {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }
</style>

@section Scripts {
    @* The '!' prefix opts this element out of tag helper processing: the script tag helper
       would otherwise strip the type="importmap" attribute and break module resolution. *@
    <!script type="importmap">
        {
            "imports": {
                "three": "https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js",
                "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.170.0/examples/jsm/",
                "three-mesh-bvh": "https://cdn.jsdelivr.net/npm/three-mesh-bvh@0.8/build/index.module.js",
                "gltf-viewer-core": "@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, "/js/gltf-viewer-core.js")"
            }
        }
    </!script>
    <script type="module" src="~/js/gltf-viewer.js" asp-append-version="true"></script>
    <script type="module" src="~/js/communication-tools.js" asp-append-version="true"></script>
    <script type="module" src="~/js/building-details-panel.js" asp-append-version="true"></script>
}
