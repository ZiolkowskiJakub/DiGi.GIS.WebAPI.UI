@using DiGi.GIS.Classes
@using System.Linq
@using System.Collections.Generic
@using DiGi.GIS.WebAPI.UI.ViewModels

@model Building2DOccupancyDataViewModel

@{
    @* Ensure we have a valid model instance *@
    Building2DOccupancyDataViewModel building2DOccupancyDataViewModel = Model ?? new Building2DOccupancyDataViewModel();
}

@if (building2DOccupancyDataViewModel.OccupancyData is DiGi.GIS.Classes.OccupancyData occupancyData &&
     occupancyData is not null)
{
    @* Main container matching the 'Calculated General Properties' layout *@
    <div class="property-group success">
        @* Header with green accent color *@
        <h4>
            Occupancy Data
        </h4>

        <table class="gis-property-table">
            <tr>
                <td class="property-label">
                    Calculated Occupancy:
                </td>
                <td>
                    @occupancyData.Occupancy
                </td>
            </tr>
        </table>
    </div>
}
