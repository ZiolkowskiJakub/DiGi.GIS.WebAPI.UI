@{
    ViewData["Title"] = "Sign in";
    ViewData["Description"] = "Sign in to the gis.digiproject.uk platform with your DigiProject account.";
    ViewData["Robots"] = "noindex, nofollow";

    string returnUrl = ViewData["ReturnUrl"] as string ?? Url.Content("~/");
}

<div class="gis-panel">
    <div class="gis-card gis-hero-card gis-card-narrow">
        @* Padlock line icon, from the same line-icon set as the Terrain, 3D viewer and Communication start pages. *@
        <div class="gis-hero-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                <rect width="18" height="11" x="3" y="11" rx="2" ry="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                <path d="M12 15v2" />
            </svg>
        </div>
        <h2 class="gis-title gis-title-hero">Sign in</h2>
        <p class="gis-hero-text">
            Sign in with the e-mail address and password of your DigiProject account. Accounts are created by the
            DigiProject team - there is no self-registration and no password reset here.
        </p>

        <form id="gis-login-form" data-return-url="@returnUrl">
            <label class="gis-field-label">E-mail
                <input type="email" name="email" autocomplete="email" autocapitalize="none" spellcheck="false" required />
            </label>
            <label class="gis-field-label">Password
                <input type="password" name="password" autocomplete="current-password" required />
            </label>

            @* One message for every refusal. A wrong password, an unknown address and an account whose
               credential was never set are a single 401 to the authentication service, and they stay a single
               answer here: telling them apart would tell anyone probing which addresses exist. *@
            <p id="gis-login-error" class="text-danger" role="alert" hidden></p>

            <button id="gis-login-submit" type="submit" class="gis-button">Sign in</button>
        </form>

        <noscript>
            <p class="text-danger">Signing in needs JavaScript to be enabled.</p>
        </noscript>

        <a href="~/" class="back-button">&#8592; Return to Main Menu</a>
    </div>
</div>

@section Scripts {
    @* user.js is already loaded by the layout for the header control, so only the wiring is needed here. *@
    <script>
        digiUser.setupLoginForm('gis-login-form');
    </script>
}
