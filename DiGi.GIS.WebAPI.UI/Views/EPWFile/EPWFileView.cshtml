@using System.Linq
@using DiGi.GIS.WebAPI.UI.ViewModels
@using DiGi.EPW.Classes
@model EPWFileViewModel

@{
    ViewData["Title"] = "EPW Weather Data";
    ViewData["Description"] = "EPW Weather Data";
}

@{
    EPWFileViewModel view = Model ?? new EPWFileViewModel();
    EPWFile? epwFile = view.EPWFile;
}

<div class="gis-table-container margin-large">
    <h1 class="gis-title-large">EPW Weather Data</h1>

    @if (epwFile != null)
    {
        @* --- BLOCK 1: General --- *@
        <div class="property-group">
            <h4>General</h4>
            <table class="gis-property-table">
                @if (epwFile.Location != null)
                {
                    <tr>
                        <td class="property-label">City:</td>
                        <td>@(epwFile.Location.City ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Country:</td>
                        <td>@(epwFile.Location.Country ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Region:</td>
                        <td>@(epwFile.Location.Region ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Latitude:</td>
                        <td>@epwFile.Location.Latitude</td>
                    </tr>
                    <tr>
                        <td class="property-label">Longitude:</td>
                        <td>@epwFile.Location.Longitude</td>
                    </tr>
                    <tr>
                        <td class="property-label">Elevation:</td>
                        <td>@epwFile.Location.Elevation m</td>
                    </tr>
                    <tr>
                        <td class="property-label">Time Zone:</td>
                        <td>@epwFile.Location.TimeZone</td>
                    </tr>
                    <tr>
                        <td class="property-label">WHO:</td>
                        <td>@(epwFile.Location.WHO ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Source:</td>
                        <td>@(epwFile.Location.Source ?? string.Empty)</td>
                    </tr>
                }
                @if (epwFile.DesignConditions != null)
                {
                    <tr>
                        <td class="property-label">Design Conditions Name:</td>
                        <td>@(epwFile.DesignConditions.Name ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Design Conditions Source:</td>
                        <td>@(epwFile.DesignConditions.Source ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Number of Design Conditions:</td>
                        <td>@epwFile.DesignConditions.NumberOfDesignConditions</td>
                    </tr>
                }
                @if (epwFile.HolidaysDaylightSaving != null)
                {
                    <tr>
                        <td class="property-label">Leap Year Observed:</td>
                        <td>@(epwFile.HolidaysDaylightSaving.LeapYearObserved ? "Yes" : "No")</td>
                    </tr>
                    <tr>
                        <td class="property-label">Daylight Saving Start:</td>
                        <td>@(epwFile.HolidaysDaylightSaving.DaylightSavingStartDate ?? string.Empty)</td>
                    </tr>
                    <tr>
                        <td class="property-label">Daylight Saving End:</td>
                        <td>@(epwFile.HolidaysDaylightSaving.DaylightSavingEndDate ?? string.Empty)</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(epwFile.Comments1))
                {
                    <tr>
                        <td class="property-label">Comments 1:</td>
                        <td>@epwFile.Comments1</td>
                    </tr>
                }
                @if (!string.IsNullOrWhiteSpace(epwFile.Comments2))
                {
                    <tr>
                        <td class="property-label">Comments 2:</td>
                        <td>@epwFile.Comments2</td>
                    </tr>
                }
            </table>
        </div>

        @* --- BLOCK 2: Data --- *@
        <div class="property-group">
            <h4>Data</h4>
            <div style="overflow-x: auto; max-height: 500px; overflow-y: auto; border: 1px solid #eee; border-radius: 4px; margin-top: 10px;">
                <table class="gis-property-table" style="width: 100%; table-layout: fixed; border-collapse: collapse; margin: 0; font-size: 0.85em;">
                    <colgroup>
                        <col style="width: 11%;" />
                        <col style="width: 9%;" />
                        <col style="width: 9%;" />
                        <col style="width: 8%;" />
                        <col style="width: 10%;" />
                        <col style="width: 9%;" />
                        <col style="width: 8%;" />
                        <col style="width: 9%;" />
                        <col style="width: 9%;" />
                        <col style="width: 9%;" />
                    </colgroup>
                    <thead>
                        <tr style="border-bottom: 2px solid #ddd; position: sticky; top: 0; background-color: #fff; z-index: 1;">
                            <th style="padding: 6px 6px; text-align: left; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Time</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Dry Bulb<br />(°C)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Dew Point<br />(°C)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">RH<br />(%)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Pressure<br />(Pa)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Wind Spd<br />(m/s)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Wind Dir<br />(°)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Global<br />(Wh/m²)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; border-right: 1px solid #eee; white-space: normal; word-wrap: break-word;">Direct<br />(Wh/m²)</th>
                            <th style="padding: 6px 6px; text-align: right; background-color: #f9f9f9; font-weight: bold; white-space: normal; word-wrap: break-word;">Diffuse<br />(Wh/m²)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (epwFile.DataRecords != null && epwFile.DataRecords.Any())
                        {
                            foreach (DataRecord record in epwFile.DataRecords)
                            {
                                <tr style="border-bottom: 1px solid #eee;">
                                    <td style="padding: 6px 6px; border-right: 1px solid #eee; white-space: nowrap;">@($"{record.DateTime.Year}-{record.DateTime.Month:D2}-{record.DateTime.Day:D2} {record.DateTime.Hour:D2}:{record.DateTime.Minute:D2}")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.DryBulbTemperature.ToString("F1")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.DewPointTemperature.ToString("F1")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.RelativeHumidity.ToString("F0")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.AtmosphericStationPressure.ToString("N0")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.WindSpeed.ToString("F1")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.WindDirection.ToString("F0")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.GlobalHorizontalRadiation.ToString("F0")</td>
                                    <td style="padding: 6px 6px; text-align: right; border-right: 1px solid #eee;">@record.DirectNormalRadiation.ToString("F0")</td>
                                    <td style="padding: 6px 6px; text-align: right;">@record.DiffuseHorizontalRadiation.ToString("F0")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" style="padding: 20px; text-align: center; color: var(--text-muted);">
                                    No detailed weather records available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div style="padding: 20px; text-align: center; color: var(--text-muted);">
            No EPW weather data available.
        </div>
    }
</div>
