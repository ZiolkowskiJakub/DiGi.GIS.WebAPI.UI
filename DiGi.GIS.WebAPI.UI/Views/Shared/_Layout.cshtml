<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GIS System</title>
    <meta name="description" content="@(ViewData["Description"] ?? "High-performance GIS data exchange platform by DigiProject.")" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - GIS System" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "High-performance GIS data exchange platform by DigiProject.")" />
    <meta property="og:url" content="@(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)" />
    <meta property="og:image" content="https://digiproject.uk/images/og-share-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content="@ViewData["Title"] - GIS System" />
    <meta property="twitter:description" content="@(ViewData["Description"] ?? "High-performance GIS data exchange platform by DigiProject.")" />
    <meta property="twitter:image" content="https://digiproject.uk/images/og-share-image.png" />

    <link rel="stylesheet" href="~/css/gis-theme.css" asp-append-version="true" />
    <script>
        window.AppBaseUrl = '@Url.Content("~/")';
    </script>
</head>
<body class="gis-app-body">
    @{
        string currentPath = Context.Request.Path.Value ?? "";
    }
    <header class="gis-header">
        <div class="gis-header-container">
            <a href="~/" class="gis-logo-link">
                <img src="~/images/logo.png" alt="GIS Logo" class="gis-header-logo" />
            </a>
            @* The navigation links are collapsed into a hamburger button and dropdown menu. The menu
               items mirror the main menu (Views/Home/Start.cshtml), including Communication, plus the
               3D Viewer entry. *@
            <nav class="gis-nav">
                <button type="button" id="gis-nav-toggle" class="gis-nav-toggle" aria-label="Open navigation menu" aria-haspopup="true" aria-expanded="false" aria-controls="gis-nav-menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role="img" aria-hidden="true">
                        <line x1="4" x2="20" y1="6" y2="6" />
                        <line x1="4" x2="20" y1="12" y2="12" />
                        <line x1="4" x2="20" y1="18" y2="18" />
                    </svg>
                </button>
                <div id="gis-nav-menu" class="gis-nav-menu" role="menu" hidden>
                    <a href="~/administrativeareal2D" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/administrativeareal2D", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Administrative Areas</a>
                    <a href="~/building2D" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/building2D", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Buildings</a>
                    <a href="~/communication" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/communication", StringComparison.OrdinalIgnoreCase) ? "active" : "")">Communication</a>
                    <a href="~/gltf" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/gltf", StringComparison.OrdinalIgnoreCase) ? "active" : "")">3D Viewer</a>
                    <a href="~/about" role="menuitem" class="gis-nav-link @(currentPath.StartsWith("/about", StringComparison.OrdinalIgnoreCase) ? "active" : "")">About</a>
                </div>
            </nav>
        </div>
    </header>
    <button type="button" id="gis-layout-toggle" class="gis-layout-toggle" aria-label="Toggle header and footer" title="Toggle header and footer">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="gis-layout-toggle-icon">
            <polyline points="18 15 12 9 6 15"></polyline>
        </svg>
    </button>
    <main class="gis-content-wrapper">
        @RenderBody()
    </main>
    <footer class="gis-footer">
        <div class="gis-footer-container">
            <div class="gis-footer-left">
                <a href="https://digiproject.uk" class="gis-footer-logo-link">
                    <img src="~/images/digiproject-logo.png" alt="DigiProject Logo" class="gis-footer-logo" />
                </a>
            </div>
            <div class="gis-footer-center">
                <span class="gis-footer-copyright">
                    Copyright @@ 2026 - DigiProject. Designed by <a href="mailto:digiproject@digiproject.uk" class="gis-footer-link">DigiProject team</a>
                </span>
            </div>
            <div class="gis-footer-right">
                <!-- Spacer for perfect centering -->
            </div>
        </div>
    </footer>
    @* Header navigation dropdown: toggles the hamburger menu, closing on outside click or Escape. *@
    <script>
        (function () {
            var toggle = document.getElementById('gis-nav-toggle');
            var menu = document.getElementById('gis-nav-menu');
            if (!toggle || !menu) {
                return;
            }

            function setOpen(open) {
                toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
                menu.hidden = !open;
            }

            toggle.addEventListener('click', function (event) {
                event.stopPropagation();
                setOpen(menu.hidden);
            });

            document.addEventListener('click', function (event) {
                if (!menu.hidden && !menu.contains(event.target) && !toggle.contains(event.target)) {
                    setOpen(false);
                }
            });

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape' && !menu.hidden) {
                    setOpen(false);
                    toggle.focus();
                }
            });
        })();

        (function () {
            var layoutToggle = document.getElementById('gis-layout-toggle');
            if (!layoutToggle) {
                return;
            }
            layoutToggle.addEventListener('click', function () {
                document.body.classList.toggle('gis-layout-collapsed');
                
                // Trigger window resize event to adjust 3D viewports dynamically
                window.dispatchEvent(new Event('resize'));
                // Also trigger after the 300ms CSS transition completes to make sure the final bounds are correct
                setTimeout(function () {
                    window.dispatchEvent(new Event('resize'));
                }, 300);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
