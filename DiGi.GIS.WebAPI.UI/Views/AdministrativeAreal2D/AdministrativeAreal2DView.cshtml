@using DiGi.GIS.Classes
@using System.Linq
@using DiGi.GIS.WebAPI.UI.ViewModels
@using DiGi.GIS.PostgreSQL.Classes
@using DiGi.GIS.PostgreSQL.Enums
@using System.Globalization

@model AdministrativeAreal2DViewModel

@{
    ViewData["Title"] = Model.AdministrativeAreal2D?.Name ?? "Administrative Area";
    ViewData["Description"] = $"View details, spatial boundaries, and nested items for administrative area {Model.AdministrativeAreal2D?.Name ?? ""}.";
}

@{
    List<AdministrativeAreal2DReference> administrativeAreal2DReferences_All = Model.AdministrativeAreal2DReferences ?? [];

    DiGi.Core.Query.Filter(administrativeAreal2DReferences_All, x => x?.AdministrativeArealType == AdministrativeArealType.Subdivison, out List<AdministrativeAreal2DReference>? administrativeAreal2DReferences_Subdivision, out List<AdministrativeAreal2DReference>? administrativeAreal2DReferences);
    
    if (administrativeAreal2DReferences is not null)
    {
        administrativeAreal2DReferences = administrativeAreal2DReferences.GroupBy(area => area.Code).Select(group => group.First()).ToList();
    }
    else
    {
        administrativeAreal2DReferences = [];
    }

    if (administrativeAreal2DReferences_Subdivision is not null && administrativeAreal2DReferences_Subdivision.Count != 0)
    {
        administrativeAreal2DReferences.AddRange(administrativeAreal2DReferences_Subdivision);
    }

    administrativeAreal2DReferences.Sort((x, y) => (x?.Name ?? string.Empty).CompareTo((y?.Name ?? string.Empty)));
}

<link rel="stylesheet" href="~/css/gis-theme.css" />

<div class="gis-table-container">

    @* --- SECTION 1: AdministrativeAreal2D (Details) --- *@
    <div class="gis-main-content">
        <div class="gis-info-section">
            <h2 class="gis-title">Administrative Area</h2>
            @if (Model.AdministrativeAreal2D != null)
            {
                <div class="gis-info-row">
                    <span class="gis-info-label">Name:</span>
                    <span class="gis-info-value">@Model.AdministrativeAreal2D.Name</span>
                </div>
                <div class="gis-info-row">
                    <span class="gis-info-label">Code:</span>
                    <span>
                        <a href="~/administrativeareal2D/administrativeareal2Dreferencesbyid?id=@Model.AdministrativeAreal2DReference!.Id"
                           class="btn-buildings btn-active"
                           style="padding: 2px 8px; font-size: 0.8em; line-height: 1.5;">
                            @Model.AdministrativeAreal2DReference!.Code
                        </a>
                    </span>
                </div>

                string typeName = string.Empty;
                uint? occupancy = null;

                if (Model.AdministrativeAreal2D is AdministrativeDivision administrativeDivision)
                {
                    typeName = DiGi.Core.Query.Description(administrativeDivision.AdministrativeDivisionType) ?? string.Empty;
                }
                else if (Model.AdministrativeAreal2D is AdministrativeSubdivision administrativeSubdivision)
                {
                    typeName = DiGi.Core.Query.Description(administrativeSubdivision.AdministrativeSubdivisionType) ?? string.Empty;
                    occupancy = administrativeSubdivision.Occupancy;
                }

                <div class="gis-info-row">
                    <span class="gis-info-label">Type:</span>
                    <span class="gis-info-value">@typeName</span>
                </div>

                @if (occupancy is not null)
                {
                    <div class="gis-info-row">
                        <span class="gis-info-label">Occupancy:</span>
                        <span class="gis-info-value">@occupancy.Value.ToString("N0")</span>
                    </div>
                }

                <div class="gis-info-row">
                    <span class="gis-info-label">Buildings:</span>
                    <span>
                    @if ((int)Model.AdministrativeAreal2DReference.AdministrativeArealType >= (int)AdministrativeArealType.County)
                    {
                            <a href="~/building2D/building2Dreferencesbyadministrativeareal2Did?administrativeareal2Did=@Model.AdministrativeAreal2DReference.Id" class="btn-buildings btn-active">Buildings</a>
                    }
                    else
                    {
                            <button class="btn-buildings btn-disabled" disabled>Buildings</button>
                    }
                    </span>
                </div>
            }
        </div>

        <div class="gis-visual-side">
            <div id="svg-wrapper">
                <svg id="mainCanvas" width="300" height="300" viewBox="0 0 500 500" preserveAspectRatio="xMidYMid meet"></svg>
            </div>
        </div>
    </div>

    <div class="gis-path-breadcrumb">
        @if (Model.AdministrativeAreal2DReferencePath?.AdministrativeAreal2DReferences != null)
        {
            List<AdministrativeAreal2DReference> administrativeAreal2DReferences_Path = Model.AdministrativeAreal2DReferencePath.AdministrativeAreal2DReferences;
        
            for (int i = 0; i < administrativeAreal2DReferences_Path.Count; i++)
            {
                AdministrativeAreal2DReference administrativeAreal2DReference_Path = administrativeAreal2DReferences_Path[i];

                <div class="breadcrumb-item-wrapper">
                    @* Display Name *@
                    <span>@administrativeAreal2DReference_Path.Name</span>

                    @* Interactive Code Button *@
                    <a href="~/administrativeareal2D/administrativeareal2Dreferencesbyid?id=@administrativeAreal2DReference_Path.Id" 
                       class="btn-buildings btn-active" 
                       style="padding: 2px 8px; font-size: 0.8em; line-height: 1.5;">
                       @administrativeAreal2DReference_Path.Code
                    </a>
                </div>

                @* Separator - displayed only between items *@
                if (i < administrativeAreal2DReferences_Path.Count - 1)
                {
                    <span class="breadcrumb-separator">&gt;</span>
                }
            }
        }
    </div>

    @* --- SECTION 3: AdministrativeAreal2DReferences (Table) --- *@
    @if (administrativeAreal2DReferences is not null && administrativeAreal2DReferences.Count != 0)
    {
        <table class="gis-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Buildings</th>
                    <th>Orto Datas Coverage</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < administrativeAreal2DReferences.Count; i++)
                {
                    AdministrativeAreal2DReference administrativeAreal2DReference = administrativeAreal2DReferences[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td>@administrativeAreal2DReference.Name</td>
                        <td>
                            <a href="~/administrativeareal2D/administrativeareal2Dreferencesbyid?id=@administrativeAreal2DReference.Id"
                               onmouseenter="handleMouseEnter('@administrativeAreal2DReference.Id')"
                               onmouseleave="handleMouseLeave('@administrativeAreal2DReference.Id', '@(Model.AdministrativeAreal2DReference?.Id)')"
                               class="btn-buildings btn-active" style="padding: 4px 8px;">
                                @administrativeAreal2DReference.Code
                            </a>
                        </td>
                        <td>
                             @if ((int)administrativeAreal2DReference.AdministrativeArealType >= (int)AdministrativeArealType.County) 
                             {
                                 <a href="~/building2D/building2Dreferencesbyadministrativeareal2Did?administrativeareal2Did=@administrativeAreal2DReference.Id" class="btn-buildings btn-active">Buildings</a>
                             } 
                             else 
                             {
                                <button class="btn-buildings btn-disabled" disabled>Buildings</button>
                             }
                        </td>
                        <td>
                            <div class="coverage-wrapper">
                                <span id="text-coverage-@administrativeAreal2DReference.Id" class="coverage-text">Loading...</span>
                                <div class="coverage-container">
                                    <div id="bar-coverage-@administrativeAreal2DReference.Id" class="coverage-bar"></div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@section Scripts {
    <script src="~/js/gis-common.js" asp-append-version="true"></script>
    <script src="~/js/administrative.js" asp-append-version="true"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // 1. Existing polygon logic
            @if (Model.AdministrativeAreal2DReference != null)
            {
                <text>drawPolygons('@Model.AdministrativeAreal2DReference.Id', true);</text>
            }

            // 2. New Bulk Coverage Logic
            @{
                // Prepare list of IDs in C# first
                List<int> idList = administrativeAreal2DReferences?
                        .Select(x => x.Id)
                        .ToList() ?? new List<int>();
                string idsJson = System.Text.Json.JsonSerializer.Serialize(idList);
            }

            const ids = @Html.Raw(idsJson);
            if (ids.length > 0) {
                loadAllOrtoCoverages(ids);
            }
        });
    </script>
}
