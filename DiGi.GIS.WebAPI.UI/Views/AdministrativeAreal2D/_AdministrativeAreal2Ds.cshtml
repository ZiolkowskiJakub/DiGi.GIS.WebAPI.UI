@using DiGi.GIS.Classes
@using System.Linq

@{
    // Logic for data preparation
    List<AdministrativeAreal2D>? administrativeAreal2Ds = (Model as IEnumerable<AdministrativeAreal2D>)?.ToList();
    
    if (administrativeAreal2Ds is null)
    {
        administrativeAreal2Ds = new List<AdministrativeAreal2D>();
    }

    administrativeAreal2Ds = administrativeAreal2Ds
        .GroupBy(area => area.Code)
        .Select(group => group.First())
        .OrderBy(area => area.Name)
        .ToList();
}

<div class="gis-table-container margin-large">
    
    <table class="gis-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Name</th>
                <th>Code</th>
                <th>Reference</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < administrativeAreal2Ds.Count; i++)
            {
                AdministrativeAreal2D item = administrativeAreal2Ds[i];

                <tr>
                    <td class="index-column">@(i + 1)</td>
                    <td class="fw-medium">@item.Name</td>
                    <td>
                        <span class="code-badge">@item.Code</span>
                    </td>
                    <td class="text-muted">@item.Reference</td>
                </tr>
            }
        </tbody>
    </table>
</div>
