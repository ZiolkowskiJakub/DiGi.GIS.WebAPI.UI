@using DiGi.GIS.WebAPI.UI.Classes

@model Building2DReferencesView

@{
    ViewData["Title"] = "Buildings";
}

<link rel="stylesheet" href="/css/gis-theme.css" />

<div class="master-detail-wrapper">
    @* LEWA STRONA: LISTA *@
    <div id="listSide">
        @* Renderujemy listę budynków z partiala *@
        @await Html.PartialAsync("_Building2DReferences", Model.Building2DReferences)
    </div>

    @* PRAWA STRONA: DETALE *@
    <div id="detailsSide">
        <div id="detailsLoader" class="details-loader">
            <div class="gis-loader"></div>
            <p style="font-size: 0.9em; color: #0078d4; font-weight: 500;">Fetching data...</p>
        </div>

        <div id="detailsContent">
            <div style="padding: 40px; text-align: center; color: #999;">
                <i style="font-size: 48px; display: block; margin-bottom: 10px;">🏢</i>
                <p>Select a building from the list to view its technical details and location.</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/building.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initBuildingReferencesView();
        });
    </script>
}