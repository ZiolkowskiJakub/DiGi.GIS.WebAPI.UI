@using System.Linq
@using DiGi.GIS.PostgreSQL.Classes

@{
    List<Building2DReference>? building2DReferences = (Model as IEnumerable<Building2DReference>)?.ToList() ?? [];
    int initialLimit = 100;
}

<div class="gis-master-wrapper">
    <div class="master-header">
        <span class="gis-title">Building References</span>
        <div class="controls-row">
            <span id="pagingStatus" style="font-size: 0.8em; color: #666; white-space: nowrap;">
                Total: <b>@building2DReferences.Count</b> (<span id="shownVal">@Math.Min(building2DReferences.Count, initialLimit)</span>)
            </span>
            <div id="paginationButtons">
                @if (building2DReferences.Count > initialLimit)
                {
                    <button type="button" class="btn-buildings" style="min-width: 60px;" onclick="revealNext(100)">+100</button>
                    <button type="button" class="btn-buildings" style="min-width: 60px; background-color: #28a745; color: white; border-color: #28a745;" onclick="revealAll()">All</button>
                }
            </div>
        </div>
    </div>

    <div class="table-scroll-container">
        <table class="gis-table" id="mainBuildingsTable">
            <thead>
                <tr>
                    <th class="col-idx">#</th>
                    <th class="col-ref">Reference Name</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < building2DReferences.Count; i++)
                {
                    var item = building2DReferences[i];
                    <tr class="@(i >= initialLimit ? "row-hidden" : "")">
                        <td class="col-idx" style="color: #999; font-size: 0.8em;">@(i + 1)</td>
                        <td class="col-ref">
                            <a href="~/building2D/itembyid?id=@item.Id&countyid=@item.CountyId"
                               class="btn-buildings building-link"
                               title="@item.Reference">
                                @item.Reference
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        initTablePager(@Math.Min(building2DReferences.Count, initialLimit), @building2DReferences.Count);
    });
</script>