@using DiGi.GIS.Classes
@using System.Linq
@using DiGi.GIS.PostgreSQL.Classes

@{
    List<Building2DReference>? building2DReferences = (Model as IEnumerable<Building2DReference>)?.ToList() ?? [];
    int initialLimit = 100;
}

<style>
    /* GŁÓWNY KONTENER PARTIALA */
    .gis-master-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%; 
        width: 100%;
        background-color: white;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    /* NIERUCHOMA GÓRA (Tytuł i przyciski sterujące) */
    .master-header {
        flex: 0 0 auto;
        padding: 15px 20px;
        background: #ffffff;
        border-bottom: 1px solid #eaeaea;
        z-index: 10;
    }

    .gis-title {
        color: #333;
        margin: 0 0 12px 0;
        font-size: 1.2rem;
        font-weight: 700;
        display: block;
        border-left: 4px solid #0078d4;
        padding-left: 10px;
    }

    /* WIERSZ Z KONTROLKAMI (+100, ALL, TOTAL) */
    .controls-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

    #paginationButtons {
        display: flex;
        gap: 6px;
    }

    /* KONTENER PRZEWIJANIA SAMEJ LISTY */
    .table-scroll-container {
        flex: 1 1 auto;
        overflow-y: auto;
        overflow-x: hidden;
        position: relative;
    }

    /* STYLIZACJA TABELI */
    .gis-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed; /* Blokuje "skakanie" szerokości kolumn */
    }

    /* PRZYKLEJONY NIEBIESKI NAGŁÓWEK TABELI */
    .gis-table thead th {
        position: sticky;
        top: 0;
        background-color: #0078d4;
        color: white;
        z-index: 5;
        padding: 12px 10px;
        text-align: left;
        font-size: 0.9em;
        font-weight: 600;
    }

    /* KONFIGURACJA SZEROKOŚCI KOLUMN */
    .col-idx { width: 45px; text-align: center; }
    .col-ref { width: auto; }

    .gis-table td {
        padding: 8px 10px;
        border-bottom: 1px solid #f0f0f0;
        vertical-align: middle;
    }

    .gis-table tr:hover {
        background-color: #f8fbfe;
    }

    /* STYL PRZYCISKU / LINKU */
    .btn-buildings {
        display: block;          /* Wypełnia całą komórkę */
        width: 100%;             /* Stała szerokość w ramach kolumny */
        box-sizing: border-box;
        padding: 6px 12px;
        border-radius: 4px;
        text-decoration: none;
        font-size: 0.85em;
        font-weight: 600;
        border: 1px solid #0078d4;
        background-color: #e1f0fe;
        color: #0078d4;
        text-align: center;
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis; /* Kropki jeśli tekst jest za długi */
        transition: all 0.2s;
    }

    .btn-buildings:hover {
        background-color: #0078d4;
        color: white;
    }

    /* Akcent dla wybranego budynku */
    .active-selection {
        background-color: #0078d4 !important;
        color: white !important;
    }

    .row-hidden {
        display: none;
    }
</style>

<div class="gis-master-wrapper">
    <div class="master-header">
        <span class="gis-title">Building References</span>
        <div class="controls-row">
            <span id="pagingStatus" style="font-size: 0.8em; color: #666; white-space: nowrap;">
                Total: <b>@building2DReferences.Count</b> (<span id="shownVal">@Math.Min(building2DReferences.Count, initialLimit)</span>)
            </span>
            <div id="paginationButtons">
                @if (building2DReferences.Count > initialLimit)
                {
                    <button type="button" class="btn-buildings" style="min-width: 60px;" onclick="revealNext(100)">+100</button>
                    <button type="button" class="btn-buildings" style="min-width: 60px; background-color: #28a745; color: white; border-color: #28a745;" onclick="revealAll()">All</button>
                }
            </div>
        </div>
    </div>

    <div class="table-scroll-container">
        <table class="gis-table" id="mainBuildingsTable">
            <thead>
                <tr>
                    <th class="col-idx">#</th>
                    <th class="col-ref">Reference Name</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < building2DReferences.Count; i++)
                {
                    var item = building2DReferences[i];
                    <tr class="@(i >= initialLimit ? "row-hidden" : "")">
                        <td class="col-idx" style="color: #999; font-size: 0.8em;">@(i + 1)</td>
                        <td class="col-ref">
                            <a href="/building2D/itembyid?id=@item.Id&countyid=@item.CountyId"
                               class="btn-buildings building-link"
                               title="@item.Reference">
                                @item.Reference
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
    let displayedCount = @Math.Min(building2DReferences.Count, initialLimit);
    const totalRecords = @building2DReferences.Count;

    function revealNext(batchSize) {
        const hiddenRows = document.querySelectorAll('#mainBuildingsTable tbody tr.row-hidden');
        const toShow = Math.min(batchSize, hiddenRows.length);
        
        for (let i = 0; i < toShow; i++) {
            hiddenRows[i].classList.remove('row-hidden');
            displayedCount++;
        }
        updateUI();
    }

    function revealAll() {
        document.querySelectorAll('#mainBuildingsTable tbody tr.row-hidden').forEach(r => {
            r.classList.remove('row-hidden');
        });
        displayedCount = totalRecords;
        updateUI();
    }

    function updateUI() {
        document.getElementById('shownVal').innerText = displayedCount;
        if (displayedCount >= totalRecords) {
            const btns = document.getElementById('paginationButtons');
            if(btns) btns.style.display = 'none';
        }
    }
</script>

