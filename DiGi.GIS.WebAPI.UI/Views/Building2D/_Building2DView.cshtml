@using DiGi.GIS.Classes
@using System.Linq
@using DiGi.GIS.WebAPI.UI.Classes
@using DiGi.GIS.PostgreSQL.Classes

@model Building2DView

@{
    Building2DView building2DView = Model ?? new Building2DView();
    System.Collections.Generic.List<AdministrativeAreal2DReference>? pathItems = building2DView.AdministrativeAreal2DReferencePath?.AdministrativeAreal2DReferences;
}

<link rel="stylesheet" href="/css/gis-theme.css" />

<div class="gis-table-container">
    
    @* --- SECTION 1: Building2D (Geometry) --- *@
    <div class="gis-visual-side">
        <div id="svg-wrapper">
            @* Fixed size SVG Canvas for building geometry visualization *@
            <svg id="mainCanvas"
                 width="300"
                 height="300"
                 viewBox="0 0 500 500"
                 preserveAspectRatio="xMidYMid meet">
            </svg>
        </div>
    </div>

    @* --- SECTION 2: Building2D (Interactive Breadcrumbs) --- *@
    <div class="gis-path-breadcrumb">
        @if (pathItems != null)
        {
            for (int i = 0; i < pathItems.Count; i++)
            {
                var r = pathItems[i];

                <div class="breadcrumb-item-wrapper">
                    <span style="font-weight: 500;">@r.Name</span>
                    <a href="/administrativeareal2D/administrativeareal2Dreferencesbyid?id=@r.Id"
                           class="btn-buildings btn-active"
                           style="padding: 2px 8px; font-size: 0.8em;">
                        @r.Code
                    </a>
                </div>

                if (i < pathItems.Count - 1)
                {
                    <span class="breadcrumb-separator">&gt;</span>
                }
            }
        }
    </div>

    @* --- SECTION 3: Building2D properties (Divided into logical blocks) --- *@
    <div style="border-top: 1px solid #eee; padding-top: 20px;">
        @if (building2DView.Building2D != null)
        {

        @* --- BLOCK 1: Input Values --- *@
        <div class="property-group">
            <h4>Input General Properties</h4>
            <table class="gis-property-table">
                <tr>
                    <td class="property-label">Building Reference:</td>
                    <td>@(building2DView.Building2D.Reference ?? string.Empty)</td>
                </tr>
                <tr>
                    <td class="property-label">Guid:</td>
                    <td>@building2DView.Building2D.Guid</td>
                </tr>
                <tr>
                    <td class="property-label">General Function:</td>
                    <td>@(DiGi.Core.Query.Description(building2DView.Building2D.BuildingGeneralFunction) ?? string.Empty)</td>
                </tr>
                <tr>
                    <td class="property-label">Specific Functions:</td>
                    <td>@(string.Join(", ", building2DView.Building2D.BuildingSpecificFunctions?.Select(f => DiGi.Core.Query.Description(f)) ?? []))</td>
                </tr>
                <tr>
                    <td class="property-label">Phase:</td>
                    <td>@(DiGi.Core.Query.Description(building2DView.Building2D.BuildingPhase) ?? string.Empty)</td>
                </tr>
                <tr>
                    <td class="property-label">Storeys:</td>
                    <td>@building2DView.Building2D.Storeys</td>
                </tr>
            </table>
        </div>

        @* --- BLOCK 2: Calculated Values --- *@
        <div class="property-group success">
            <h4>Calculated General Properties</h4>
            <table class="gis-property-table">
                <tr>
                    <td class="property-label">Single Floor Area:</td>
                    <td>@DiGi.Core.Query.Round(building2DView.Building2D?.PolygonalFace2D?.GetArea() ?? 0.0, 0.01) m²</td>
                </tr>
                <tr>
                    <td class="property-label">Building Total Area:</td>
                    <td>@(DiGi.Core.Query.Round(building2DView.Building2D?.PolygonalFace2D?.GetArea() ?? 0.0, 0.01) * building2DView.Building2D?.Storeys ?? 0) m²</td>
                </tr>
                <tr>
                    <td class="property-label">Azimuth:</td>
                    <td style="font-weight: bold;">@DiGi.Core.Query.Round(DiGi.GIS.Query.Azimuth(building2DView.Building2D), 1)°</td>
                </tr>
                <tr>
                    <td class="property-label">Is Occupied:</td>
                    <td>
                        @if (DiGi.GIS.Query.IsOccupied(building2DView.Building2D))
                        {
                            <span style="color: #5cb85c; font-weight: bold;">Yes</span>
                        }
                        else
                        {
                            <span style="color: #d9534f; font-weight: bold;">No</span>
                        }
                    </td>
                </tr>

                <tr>
                    <td class="property-label">Default Shape:</td>
                    @{
                        string defaultShape = string.Empty;
                        DiGi.GIS.Classes.BuildingShapeSolver buildingShapeSolver = new BuildingShapeSolver();
                        buildingShapeSolver.Input = building2DView.Building2D;
                        if(buildingShapeSolver.Solve())
                        {
                            defaultShape = DiGi.Core.Query.Description(buildingShapeSolver.Output) ?? string.Empty;
                        }
                    }
                    <td style="font-weight: bold;">@defaultShape</td>
                </tr>
            </table>
        </div>

        @* --- BLOCK 3: Occupancy Data --- *@
        <div id="occupancy-data-section" class="property-group" style="display: none;">
            <div id="occupancy-data-container">
                @* Content injected via AJAX *@
            </div>
        </div>

        @* --- BLOCK 4: Year Built --- *@
        <div id="year-built-section" class="property-group" style="display: none;">
            <div id="year-builts-container">
                @* Content injected via AJAX *@
            </div>
        </div>

        @* --- BLOCK 5: Orto Datas --- *@
        <div id="orto-data-section" class="property-group" style="display: none;">
            <h4 style="color: #28a745; margin-bottom: 12px; font-size: 1.1em; border-left: 4px solid #28a745; padding-left: 10px;">
                Orto Data
            </h4>
            <div id="orto-datas-container">
                @* Content injected via AJAX *@
            </div>
        </div>

        @* --- BLOCK 6: Regulated Heat Transfer Coefficients --- *@
        <div id="regulated-heat-transfer-coefficients-section" class="property-group" style="display: none;">
                <h4 style="color: #28a745; margin-bottom: 12px; font-size: 1.1em; border-left: 4px solid #28a745; padding-left: 10px;">
                Regulated Heat Transfer Coefficients
                </h4>
            <div id="regulated-heat-transfer-coefficients-container">
                    @* Content injected via AJAX *@
            </div>
        </div>
    }
    </div>
</div>

<script>
    window.initializeBuildingGeometry = async function() {
        @if (building2DView.Building2DReference != null)
        {
            string? countyId = building2DView.Building2DReference.CountyId?.ToString();
            string? buildingId = building2DView.Building2DReference.Id.ToString();
            string reference = building2DView.Building2DReference?.Reference ?? string.Empty;

            <text>
                // Draw polygons
                await drawPolygon('@countyId', '@buildingId');

                // Load the Partial View for Occupancy
                await loadOccupancyData('@reference', '@countyId');

                // Load the Partial View for Year Builts
                await loadYearBuiltData('@reference', '@countyId');

                // Load the Partial View for OrtoData
                await loadOrtoDatas('@reference', '@countyId');

                // Load the Partial View for Regulated Heat Transfer Coefficients
                await loadRegulatedHeatTransferCoefficients('@reference', '@countyId');
            </text>
        }
    };

    async function drawPolygon(countyId, id) {
        if (!id || !countyId) return;

        try {
            const response = await fetch(`/building2D/svg/polygonbyid?id=${id}&countyid=${countyId}`);
            if (!response.ok) return;

            const rawData = await response.text();
            const coords = rawData.trim().split(/\s+/).map(Number);
            if (coords.length < 4) return;

            // 1. Calculating bounds (Bounding Box)
            let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
            for (let i = 0; i < coords.length; i += 2) {
                let x = coords[i];
                let y = coords[i+1];
                if (x < minX) minX = x; if (x > maxX) maxX = x;
                if (y < minY) minY = y; if (y > maxY) maxY = y;
            }

            const width = maxX - minX;
            const height = maxY - minY;
            const canvasSize = 500;
            const margin = 40; // Safe margin from the edge
            const drawingArea = canvasSize - (2 * margin);

            // 2. Calculating scale preserving aspect ratio (Aspect Ratio)
            const scale = Math.min(drawingArea / width, drawingArea / height);

            // 3. Calculating centering offset
            // Verify how much space the scaled building will occupy
            const scaledWidth = width * scale;
            const scaledHeight = height * scale;

            // Offset is half the difference between canvas size and drawn object size
            const offsetX = (canvasSize - scaledWidth) / 2;
            const offsetY = (canvasSize - scaledHeight) / 2;

            let pointsArray = [];
            for (let i = 0; i < coords.length; i += 2) {
                // Normalize to (0,0), scale, and add centering offset
                let screenX = (coords[i] - minX) * scale + offsetX;
            
                // In SVG the Y axis increases downwards, so we invert the orientation of GIS coordinates
                // (canvasSize - ...) inverts the axis, and offsetY centers the result
                let screenY = canvasSize - ((coords[i+1] - minY) * scale + offsetY);
            
                pointsArray.push(`${screenX.toFixed(2)},${screenY.toFixed(2)}`);
            }

            const pointsAttr = pointsArray.join(" ");
            const svg = document.getElementById("mainCanvas");
        
            if (svg) {
                // IMPORTANT: Clear SVG before drawing a new shape
                // Prevents multiple polygons from overlapping when switching records
                while (svg.firstChild) {
                    svg.removeChild(svg.firstChild);
                }

                const polygon = document.createElementNS("http://www.w3.org/2000/svg", "polygon");
                polygon.setAttribute("points", pointsAttr);
                polygon.style.fill = "rgba(0, 120, 212, 0.2)";
                polygon.style.stroke = "#0078d4";
                polygon.style.strokeWidth = "2";
                svg.appendChild(polygon);
            }
        } catch (error) {
            console.error("Normalization error:", error);
        }
    }

    // Function to fetch Partial View HTML and inject it into the DOM
    async function loadYearBuiltData(reference, countyId) {
        if (!reference) return;

        const section = document.getElementById("year-built-section");
        const container = document.getElementById("year-builts-container");
    
        // Constructing URL for YearBuiltDataController
        const url = `/yearbuiltdata/itembyreference?reference=${encodeURIComponent(reference)}&countyid=${countyId}`;

        try {
            const response = await fetch(url);

            // Check if the response is 204 NoContent or 404
            if (response.status === 204 || response.status === 404) {
                console.log("No year built data found. Section will remain hidden.");
                section.style.display = "none";
                return;
            }

            if (response.ok) {
                const htmlContent = await response.text();
            
                // If the content is empty string, hide section
                if (!htmlContent.trim()) {
                    section.style.display = "none";
                    return;
                }

                // Inject HTML and show the section
                container.innerHTML = htmlContent;
                section.style.display = "block";
            } else {
                console.error("Server returned an error status:", response.status);
                section.style.display = "none";
            }
        } catch (error) {
            console.error("AJAX Error during fetching Year Builts:", error);
            section.style.display = "none";
        }
    }

    //Fetches Orto Data Partial View and manages section visibility
    async function loadOrtoDatas(reference, countyId) {
        if (!reference) return;

        const section = document.getElementById("orto-data-section");
        const container = document.getElementById("orto-datas-container");
        
        // URL targeting OrtoDatasController.GetItemByIdAsync
        const url = `/ortodatas/itembyreference?reference=${encodeURIComponent(reference)}&countyid=${countyId}`;

        try {
            const response = await fetch(url);

            // If the controller returns NoContent()
            if (response.status === 204) {
                section.style.display = "none";
                return;
            }

            if (response.ok) {
                const htmlContent = await response.text();
                
                if (htmlContent.trim().length > 0) {
                    container.innerHTML = htmlContent;
                    section.style.display = "block";
                } else {
                    section.style.display = "none";
                }
            }
        } catch (error) {
            console.error("Error loading Orto Data:", error);
            section.style.display = "none";
        }
    }

    async function loadOccupancyData(reference, countyId) {
        if (!reference) return;

        const section = document.getElementById("occupancy-data-section");
        const container = document.getElementById("occupancy-data-container");
        
        const url = `/occupancydata/building2d/itembyreference?reference=${encodeURIComponent(reference)}&countyid=${countyId}`;

        try {
            const response = await fetch(url);

            // If the controller returns NoContent()
            if (response.status === 204) {
                section.style.display = "none";
                return;
            }

            if (response.ok) {
                const htmlContent = await response.text();
                
                if (htmlContent.trim().length > 0) {
                    container.innerHTML = htmlContent;
                    section.style.display = "block";
                } else {
                    section.style.display = "none";
                }
            }
        } catch (error) {
            console.error("Error loading Occupancy Data:", error);
            section.style.display = "none";
        }
    }

    async function loadRegulatedHeatTransferCoefficients(reference, countyId) {
        if (!reference) return;

        const section = document.getElementById("regulated-heat-transfer-coefficients-section");
        const container = document.getElementById("regulated-heat-transfer-coefficients-container");
        
        const url = `/heattransfercoefficient/regulatedheattransfercoefficientsbyreference?reference=${encodeURIComponent(reference)}&countyid=${countyId}`;

        try {
            const response = await fetch(url);

            // If the controller returns NoContent()
            if (response.status === 204) {
                section.style.display = "none";
                return;
            }

            if (response.ok) {
                const htmlContent = await response.text();
                
                if (htmlContent.trim().length > 0) {
                    container.innerHTML = htmlContent;
                    section.style.display = "block";
                } else {
                    section.style.display = "none";
                }
            }
        } catch (error) {
            console.error("Error loading Regulated Heat Transfer Coefficients Data:", error);
            section.style.display = "none";
        }
    }

</script>