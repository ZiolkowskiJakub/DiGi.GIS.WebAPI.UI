@{
    ViewData["Title"] = "Buildings";
    ViewData["Description"] = "Explore the building directory and query spatial and architectural attributes of buildings in the GIS database.";
}

<div class="gis-panel">
    <div class="gis-card" style="text-align: center; padding: 50px 20px;">
        <div style="font-size: 4rem; margin-bottom: 20px; color: var(--primary-color);">🏢</div>
        <h2 class="gis-title" style="border: none; padding: 0; margin-bottom: 15px; display: block; font-size: 1.8rem;">Buildings Directory</h2>
        <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto 30px; font-size: 1.1rem; line-height: 1.6;">
            To view buildings and their technical details, please first select an administrative area.
        </p>
        <a href="~/administrativeareal2D" class="gis-button" style="text-decoration: none;">
            Go to Administrative Areas
        </a>
    </div>
</div>