@{
    ViewData["Title"] = "About System";
    ViewData["Description"] = "Learn about the gis.digiproject.uk platform for high-performance PostgreSQL spatial data exchange using Npgsql.";
}

<div class="gis-home-container">
    <div class="gis-about-card">
        <h1 class="gis-title-large">About System</h1>
        
        <p>
            Welcome to the <strong>gis.digiproject.uk</strong> platform.
            This system facilitates high-performance data exchange between users and
            PostgreSQL databases using Npgsql and specialized C# DLL libraries.
        </p>

        <div class="server-time">
            Server Synchronization: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")
        </div>

        <a href="~/" class="back-button">← Return to Main Menu</a>
    </div>
</div>