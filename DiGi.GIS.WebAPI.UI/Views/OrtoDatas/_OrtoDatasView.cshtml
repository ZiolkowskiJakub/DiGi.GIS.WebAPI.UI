@using DiGi.GIS.WebAPI.UI.ViewModels

@model OrtoDatasViewModel

@{
    @* Initializing the view object and dictionary with explicit typing *@
    OrtoDatasViewModel ortoDatasView = Model ?? new OrtoDatasViewModel();
    SortedDictionary<int, byte[]> dictionary = new SortedDictionary<int, byte[]>();

    if (ortoDatasView.OrtoDatas is DiGi.GIS.Classes.OrtoDatas ortoDatas)
    {
        if (ortoDatas.TryGetYears(out HashSet<int>? years) && years is not null && years.Count > 0)
        {
            foreach (int year in years)
            {
                if (ortoDatas.GetBytes(new DateTime(year, 1, 1)) is byte[] bytes)
                {
                    dictionary[year] = bytes;
                }
            }
        }
    }
}



<div class="orto-grid">
    @foreach (KeyValuePair<int, byte[]> item in dictionary)
    {
        string base64String = System.Convert.ToBase64String(item.Value);
        string imageSource = $"data:image/png;base64,{base64String}";
        int yearValue = item.Key;

        <div class="orto-card">
            <img src="@imageSource" alt="Year @yearValue" class="orto-image" />
            <div class="orto-footer">
                Year: @yearValue
            </div>
        </div>
    }
</div>
