@using DiGi.Analytical.Building.HVAC.Classes
@using DiGi.Analytical.Building.HVAC.Interfaces
@using DiGi.GIS.Classes
@using System.Linq
@using System.Collections.Generic
@using DiGi.GIS.WebAPI.UI.ViewModels
@using DiGi.GIS.PostgreSQL.Classes
@using DiGi.GIS.PostgreSQL.Enums
@using DiGi.GIS.Interfaces

@model RegulatedHeatTransferCoefficientsViewModel

@{
    // Ensure we have a valid model instance using explicit typing
    RegulatedHeatTransferCoefficientsViewModel viewData = Model ?? new RegulatedHeatTransferCoefficientsViewModel();
}

@if (viewData.RegulatedHeatTransferCoefficients is IRegulatedHeatTransferCoefficients regulatedHeatTransferCoefficients)
{
    <div class="property-group">
        <table class="gis-property-table">
            @if (regulatedHeatTransferCoefficients.RegulationAct is RegulationAct regulationAct)
            {
                <tr>
                    <td class="property-label">Reference</td>
                    <td>@regulationAct.Reference</td>
                </tr>
                <tr>
                    <td class="property-label">Publication Date</td>
                    <td>@regulationAct.PublicationDate.ToShortDateString()</td>
                </tr>
                <tr>
                    <td class="property-label">Effective Date</td>
                    <td>@regulationAct.EffectiveDate.ToShortDateString()</td>
                </tr>
                <tr>
                    <td class="property-label">Name</td>
                    <td>@regulationAct.Name</td>
                </tr>
            }

            @{
                // Extracting logic to explicit types
                List<string>? names = regulatedHeatTransferCoefficients.GetNames();
                if (viewData.IsResidential is bool isResidential)
                {
                    names?.RemoveAll(x => x.ToLower().StartsWith(isResidential ? "public" : "residential"));
                }

                int totalItems = names?.Count ?? 0;
            }

            @for (int i = 0; i < totalItems; i++)
            {
                string? name = names![i];
                double coefficientValue = 0;
                regulatedHeatTransferCoefficients.TryGetValue(name, out coefficientValue);

                <tr>
                    <td class="property-label">@name:</td>
                    <td>@coefficientValue [W/(m²·K)]</td>
                </tr>
            }
        </table>
    </div>
}
